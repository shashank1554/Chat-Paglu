TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OWNER_CHAT_ID=your_telegram_chat_id

OPEN_ROUTER_KEY_1=your_openrouter_key_1
OPEN_ROUTER_KEY_2=your_openrouter_key_2
OPEN_ROUTER_KEY_3=your_openrouter_key_3
OPEN_ROUTER_KEY_4=your_openrouter_key_4
OPEN_ROUTER_KEY_5=your_openrouter_key_5
OPEN_ROUTER_KEY_6=your_openrouter_key_6
OPEN_ROUTER_KEY_7=your_openrouter_key_7
OPEN_ROUTER_KEY_8=your_openrouter_key_8
OPEN_ROUTER_KEY_9=your_openrouter_key_9
OPEN_ROUTER_KEY_10=your_openrouter_key_10

# Must be a free OpenRouter model. Paid model values are ignored by the bot.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://github.com

# Optional Gemini fallback
GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY_BACKUP=your_backup_gemini_key